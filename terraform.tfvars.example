# ReportMate AWS Infrastructure
# Copy to terraform.tfvars and fill in values

region       = "ca-central-1"
environment  = "prod"
project_name = "reportmate"

# Domain
domain_name          = "reportmate.app"
enable_custom_domain = false

# Database
db_username          = "reportmate"
db_password          = "CHANGE_ME"
db_instance_class    = "db.t3.micro"
db_allocated_storage = 32

# Auth / Secrets
api_internal_secret = "CHANGE_ME"
client_passphrase   = "CHANGE_ME"

# Container sizing (CPU in units, memory in MiB)
api_cpu          = 256
api_memory       = 512
frontend_cpu     = 256
frontend_memory  = 512

# Monitoring
log_retention_days   = 30
event_retention_days = 30

# The URL browsers use to reach the API (may be empty with ingress_mode = "express")
public_api_url = "https://reportmate.example.com"

# -----------------------------------------------------------------
# Optional settings. Uncomment and adapt; every value is a placeholder.
# -----------------------------------------------------------------

# Deploy into a VPC another Terraform root owns. No VPC, IGW or NAT is created.
# For each tier use existing subnet IDs, or CIDRs for the module's own subnets.
# existing_vpc_id             = "vpc-0123456789abcdef0"
# existing_private_subnet_ids = ["subnet-0123456789abcdef0", "subnet-0123456789abcdef1"]
# existing_public_subnet_ids  = ["subnet-0123456789abcdef2", "subnet-0123456789abcdef3"]
# Or, instead of existing subnet IDs:
# existing_nat_gateway_id = "nat-0123456789abcdef0"
# private_subnet_cidrs = {
#   "ca-central-1a" = "10.0.110.0/24"
#   "ca-central-1b" = "10.0.111.0/24"
# }
# public_subnet_cidrs = {
#   "ca-central-1a" = "10.0.120.0/24"
#   "ca-central-1b" = "10.0.121.0/24"
# }
# enable_vpc_endpoints       = false
# enable_s3_gateway_endpoint = true

# In the module's own VPC, skip NAT and run tasks in the public subnets
# enable_nat_gateway      = false
# tasks_in_public_subnets = true

# Expose the API and frontend as ECS Express Mode services with
# AWS-managed HTTPS URLs (no certificate or DNS needed)
# ingress_mode = "express"

# Sign in with Microsoft Entra ID instead of Cognito
# enable_cognito         = false
# public_url             = "https://reportmate.example.com"
# azure_ad_client_id     = "00000000-0000-0000-0000-000000000000"
# azure_ad_tenant_id     = "00000000-0000-0000-0000-000000000000"
# azure_ad_client_secret = "CHANGE_ME"
# nextauth_secret        = "" # empty generates one
# allowed_domains        = ["example.com"]

# Let the API accept Entra ID bearer tokens
# api_oidc_enabled   = true
# api_oidc_issuers   = ["https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0"]
# api_oidc_audiences = ["api://00000000-0000-0000-0000-000000000000"]

# ALB mode only: accept traffic only through a CDN
# cdn_origin_restriction = {
#   prefix_list_id = "pl-0123456789abcdef0"
#   header_name    = "X-Origin-Verify"
#   header_value   = "CHANGE_ME"
# }

# Sizing
# api_min_count            = 2
# api_max_count            = 6
# frontend_min_count       = 2
# frontend_max_count       = 4
# cpu_architecture         = "X86_64"
# db_storage_type          = "gp3"
# db_max_allocated_storage = 200
# db_backup_retention_days = 14
